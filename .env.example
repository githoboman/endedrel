# ═══════════════════════════════════════════════════════════════
# Endedrel — Environment Variables (GOAT Network)
# ═══════════════════════════════════════════════════════════════

# ── Backend Server ──────────────────────────────────────────────
PORT=4002
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# ── GOAT Network (EVM-compatible, Bitcoin-secured L2) ───────────
# Chain params verified: docs.goat.network/docs/build/networks-rpc
#   Testnet3: chainId 48816
#   Mainnet:  chainId 2345
GOAT_NETWORK=testnet                 # testnet | mainnet
GOAT_TESTNET_RPC=https://rpc.testnet3.goat.network
GOAT_MAINNET_RPC=https://rpc.goat.network
GOAT_TESTNET_EXPLORER=https://explorer.testnet3.goat.network
GOAT_MAINNET_EXPLORER=https://explorer.goat.network

# CAIP-2 network id used by x402 (@x402/express route config)
#   testnet3 -> eip155:48816   mainnet -> eip155:2345
X402_NETWORK=eip155:48816

# ── x402 Payment Protocol ───────────────────────────────────────
# Server wallet that receives payments (EVM address, 0x...)
SERVER_ADDRESS=

# ⚠️ REQUIRED, NOT YET CONFIRMED FOR GOAT — fill before real settlement:
# Facilitator endpoint that verifies/settles x402 payments.
# The x402-foundation testnet facilitator is https://x402.org/facilitator;
# confirm whether GOAT runs its own before using in production.
X402_FACILITATOR_URL=

# HMAC signature encoding for GOAT's X-Sign header. Default hex (convention).
# If the first authenticated request returns 401, set this to: base64
GOAT_X402_SIGN_ENCODING=hex

# GOAT merchant portal credentials (get from the merchant portal):
#   testnet3 : https://x402-merchant-lx58aabp0r.testnet3.goat.network/merchants
#   mainnet  : https://x402-merchant.goat.network/
# The portal also shows your receiving address and the supported USDC token.
GOAT_X402_API_KEY=
GOAT_X402_API_SECRET=
GOAT_X402_MERCHANT_ID=

# ⚠️ REQUIRED, NOT YET PUBLISHED BY GOAT — fill before deploy/settlement:
# USDC (ERC-20) settlement token contract on the target GOAT network.
USDC_ADDRESS=

# ── Agent Client ────────────────────────────────────────────────
# Private key for the agent wallet (EVM hex, WITH or WITHOUT 0x)
# Generate with: npx tsx agent/src/generate-wallet.ts
AGENT_PRIVATE_KEY=

# Backend server URL the agent will call
AGENT_SERVER_URL=http://localhost:4002

# ── Contract Deployment (Hardhat) ───────────────────────────────
DEPLOYER_PRIVATE_KEY=
AGENT_REGISTRY_ADDRESS=              # set after deploy
ESCROW_TIMEOUT_BLOCKS=25600          # ≈ 24h @ GOAT ~3.374s/block (86400 ÷ 3.374)

# ── LLM for Manager Agent planning ──────────────────────────────
# If GROQ unset, falls back to Gemini; if both unset, rule-based planning
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Demo / Simulation ───────────────────────────────────────────
# When true, backend bypasses real payment settlement (live demo without
# a funded facilitator). Set false once X402_FACILITATOR_URL + USDC_ADDRESS
# are configured and the agent wallet is funded.
SIMULATION_MODE=true
