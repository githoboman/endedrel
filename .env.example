# ═══════════════════════════════════════════════════════════════
# Endedrel — Environment Variables (BOT Chain)
# ═══════════════════════════════════════════════════════════════

# ── Backend Server ──────────────────────────────────────────────
PORT=4002
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# ── BOT Chain (EVM-compatible, PoSA consensus) ──────────────────
# Chain params: dev-docs.botchain.ai
#   Testnet (Bohr): chainId 968,  rpc https://rpc.bohr.life
#   Mainnet:        chainId 677,  rpc https://rpc.botchain.ai
BOT_NETWORK=testnet                 # testnet | mainnet
BOT_TESTNET_RPC=https://rpc.bohr.life
BOT_MAINNET_RPC=https://rpc.botchain.ai
BOT_TESTNET_EXPLORER=https://scan.botchain.ai
BOT_MAINNET_EXPLORER=https://scan.botchain.ai

# CAIP-2 network id used by x402 (@x402/express route config)
#   testnet -> eip155:968   mainnet -> eip155:677
X402_NETWORK=eip155:968

# ── x402 Payment Protocol ───────────────────────────────────────
# Server wallet that receives payments (EVM address, 0x...)
SERVER_ADDRESS=

# ⚠️ REQUIRED — fill before real settlement:
# Facilitator endpoint that verifies/settles x402 payments.
# Use https://x402.org/facilitator (x402 foundation testnet facilitator)
# or set your own BOT Chain compatible facilitator URL.
X402_FACILITATOR_URL=

# HMAC signature encoding for BOT's X-Sign header. Default hex (convention).
# If the first authenticated request returns 401, set this to: base64
BOT_X402_SIGN_ENCODING=hex

# BOT Chain merchant portal credentials (get from dev-docs.botchain.ai):
#   testnet : https://x402-api-testnet.botchain.ai/merchants
#   mainnet : https://x402-api.botchain.ai/merchants
# The portal also shows your receiving address and the supported USDC token.
BOT_X402_API_KEY=
BOT_X402_API_SECRET=
BOT_X402_MERCHANT_ID=

# ⚠️ REQUIRED before live settlement:
# USDC (ERC-20) settlement token contract on the target BOT Chain network.
USDC_ADDRESS=

# ── Agent Client ────────────────────────────────────────────────
# Private key for the agent wallet (EVM hex, WITH or WITHOUT 0x)
# Generate with: npx tsx agent/src/generate-wallet.ts
AGENT_PRIVATE_KEY=

# Backend server URL the agent will call
AGENT_SERVER_URL=http://localhost:4002

# ── Contract Deployment (Hardhat) ───────────────────────────────
DEPLOYER_PRIVATE_KEY=
AGENT_REGISTRY_ADDRESS=              # set after deploy
ESCROW_TIMEOUT_BLOCKS=25600          # ≈ 24h @ BOT Chain ~3.374s/block (86400 ÷ 3.374)

# ── LLM for Manager Agent planning + NLP worker agents ──────────
# Providers are tried in order: NVIDIA → Groq → Gemini → deterministic fallback.
# Agents ALWAYS respond; an LLM key just upgrades NLP/code output quality.
#
# NVIDIA NIM (OpenAI-compatible). Get a key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b   # verified working; many NVIDIA models are account-gated
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1   # optional override
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Demo / Simulation ───────────────────────────────────────────
# When true, backend bypasses real payment settlement (live demo without
# a funded facilitator). Set false once X402_FACILITATOR_URL + USDC_ADDRESS
# are configured and the agent wallet is funded.
SIMULATION_MODE=true
