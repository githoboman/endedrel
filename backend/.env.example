# ═══════════════════════════════════════════════════════════════
# Endedrel Backend — Environment Variables (BOT Chain)
# ═══════════════════════════════════════════════════════════════

PORT=4002
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=*

# BOT Chain network: testnet | mainnet
BOT_NETWORK=testnet

# EVM address that receives payments (0x...)
SERVER_ADDRESS=

# x402 Facilitator URL (leave blank for simulation mode)
X402_FACILITATOR_URL=

# BOT Chain merchant portal credentials (dev-docs.botchain.ai)
BOT_X402_API_KEY=
BOT_X402_API_SECRET=
BOT_X402_MERCHANT_ID=

# USDC contract address on target BOT Chain network
USDC_ADDRESS=
